#!/usr/bin/env bash
#
# ccswitch - switch between multiple Claude Code accounts
#
# Everything stays shared: MCP servers, plugins, skills, agents, commands,
# session history, settings and CLAUDE.md all live in one ~/.claude.
# Only the credential (and the identity it belongs to) is swapped.
#
# https://github.com/2hmad/ccswitch
# MIT licensed.

set -euo pipefail

VERSION="0.5.1"

# --- locations --------------------------------------------------------------
if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
  CC_DIR="$CLAUDE_CONFIG_DIR"
  CC_JSON="$CLAUDE_CONFIG_DIR/.claude.json"
else
  CC_DIR="$HOME/.claude"
  CC_JSON="$HOME/.claude.json"
fi
CRED="$CC_DIR/.credentials.json"

# --- credential backend -----------------------------------------------------
# Linux keeps the OAuth credential in a file. macOS keeps it in the login
# keychain, under a service name Claude Code derives from its config dir.
# Both hold the same JSON, so everything above this layer is backend-agnostic.
#
# Service: "Claude Code" + "-credentials" + ("-" + sha256(config dir)[:8] when
# CLAUDE_CONFIG_DIR is set). Account: $USER, or "claude-code-user" if that is
# unset or has characters outside [a-zA-Z0-9._-].
if [ -n "${CCSWITCH_BACKEND:-}" ]; then
  BACKEND="$CCSWITCH_BACKEND"
elif [ "$(uname -s)" = "Darwin" ] && [ ! -f "$CRED" ]; then
  BACKEND="keychain"
else
  BACKEND="file"
fi

kc_service() {
  local extra=""
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    extra="-$(python3 - "$CC_DIR" <<'PYEOF'
import hashlib, sys, unicodedata
d = unicodedata.normalize("NFC", sys.argv[1])
print(hashlib.sha256(d.encode("utf-8")).hexdigest()[:8])
PYEOF
)"
  fi
  printf 'Claude Code-credentials%s' "$extra"
}

kc_account() {
  local u="${USER:-}"
  [ -n "$u" ] || u="$(id -un 2>/dev/null || true)"
  case "$u" in
    ""|*[!a-zA-Z0-9._-]*) u="claude-code-user" ;;
  esac
  printf '%s' "$u"
}

# Present? 0 if a live credential exists.
cred_exists() {
  if [ "$BACKEND" = "keychain" ]; then
    security find-generic-password -a "$(kc_account)" -s "$(kc_service)" >/dev/null 2>&1
  else
    [ -f "$CRED" ]
  fi
}

# Print the live credential JSON on stdout.
cred_read() {
  if [ "$BACKEND" = "keychain" ]; then
    security find-generic-password -a "$(kc_account)" -s "$(kc_service)" -w 2>/dev/null
  else
    cat "$CRED"
  fi
}

# Install $1 (a file of credential JSON) as the live credential.
cred_write() {  # $1=source file
  if [ "$BACKEND" = "keychain" ]; then
    # -X takes hex, so JSON quoting never reaches the shell; -U updates in
    # place instead of failing with errSecDuplicateItem. This mirrors how
    # Claude Code itself writes the item.
    local hex; hex="$(python3 -c 'import sys;sys.stdout.write(open(sys.argv[1],"rb").read().hex())' "$1")"
    security add-generic-password -U -a "$(kc_account)" -s "$(kc_service)" -X "$hex" \
      || die "could not write to the login keychain (is it unlocked?)"
  else
    mkdir -p "$CC_DIR"
    cp "$1" "$CRED"
    chmod 600 "$CRED"
  fi
}

# Remove the live credential.
cred_clear() {
  if [ "$BACKEND" = "keychain" ]; then
    security delete-generic-password -a "$(kc_account)" -s "$(kc_service)" >/dev/null 2>&1 || true
  else
    rm -f "$CRED"
  fi
}

VAULT="${CCSWITCH_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/ccswitch}"
ACCOUNTS="$VAULT/accounts"
ACTIVE_FILE="$VAULT/active"

# Keys in .claude.json that belong to the signed-in account rather than to
# your configuration. These travel with the credential; everything else
# (mcpServers, projects, tips, onboarding state...) stays put and shared.
IDENTITY_KEYS='("oauthAccount","userID")'

# --- output -----------------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B=$'\033[1m'; DIM=$'\033[2m'; GRN=$'\033[32m'; YLW=$'\033[33m'; RED=$'\033[31m'; RST=$'\033[0m'
else
  B=""; DIM=""; GRN=""; YLW=""; RED=""; RST=""
fi

info() { printf '%s\n' "$*"; }
warn() { printf '%swarning:%s %s\n' "$YLW" "$RST" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$RED" "$RST" "$*" >&2; exit 1; }

# --- prerequisites ----------------------------------------------------------
command -v python3 >/dev/null 2>&1 || die "python3 is required but not installed"

case "$(uname -s)" in
  Linux|Darwin) ;;
  *) warn "untested platform: $(uname -s)" ;;
esac

if [ "$BACKEND" = "keychain" ]; then
  command -v security >/dev/null 2>&1 ||
    die "the 'security' command was not found - it is required to read the macOS keychain"
fi

mkdir -p "$ACCOUNTS"
chmod 700 "$VAULT" 2>/dev/null || true

# --- json helpers -----------------------------------------------------------
identity_extract() {  # $1=.claude.json  -> identity json on stdout
  python3 - "$1" <<PYEOF
import json, os, sys
p = sys.argv[1]
d = json.load(open(p)) if os.path.exists(p) else {}
print(json.dumps({k: d[k] for k in $IDENTITY_KEYS if k in d}, indent=2))
PYEOF
}

identity_apply() {  # $1=.claude.json  $2=identity.json
  python3 - "$1" "$2" <<PYEOF
import json, os, sys
tp, ip = sys.argv[1], sys.argv[2]
t = json.load(open(tp)) if os.path.exists(tp) else {}
i = json.load(open(ip)) if os.path.exists(ip) else {}
for k in $IDENTITY_KEYS:
    t.pop(k, None)
t.update(i)
os.makedirs(os.path.dirname(tp) or ".", exist_ok=True)
json.dump(t, open(tp, "w"), indent=2)
PYEOF
}

acct_email() {  # $1=account name
  python3 - "$ACCOUNTS/$1/identity.json" <<'PYEOF'
import json, os, sys
p = sys.argv[1]
if not os.path.exists(p):
    print("-"); raise SystemExit
d = json.load(open(p))
print((d.get("oauthAccount") or {}).get("emailAddress") or "-")
PYEOF
}

# Report a credential file as: "<access secs>|<refresh secs>", where either
# field may be "none". A cleared credential - Claude Code empties the tokens in
# place when the server rejects a refresh with invalid_grant - reports "dead".
cred_state() {  # $1=path to a credentials.json
  python3 - "$1" <<'PYEOF'
import json, os, sys, time
p = sys.argv[1]
if not os.path.exists(p):
    print("none|none"); raise SystemExit
try:
    d = json.load(open(p))
    o = d.get("claudeAiOauth") or {}
    if not (o.get("accessToken") or "").strip() or not (o.get("refreshToken") or "").strip():
        print("dead|dead"); raise SystemExit
    def left(k):
        v = o.get(k)
        return str(int(v / 1000 - time.time())) if v else "none"
    print("%s|%s" % (left("expiresAt"), left("refreshTokenExpiresAt")))
except SystemExit:
    raise
except Exception:
    print("none|none")
PYEOF
}

# True when the live credential holds usable tokens (not cleared by a rejected
# refresh). Guards every snapshot, so a dead session cannot overwrite a good slot.
cred_live_ok() {
  local tmp; tmp="$(mktemp)"
  cred_read > "$tmp" 2>/dev/null || true
  local st; st="$(cred_state "$tmp")"
  rm -f "$tmp"
  [ "${st%%|*}" != "dead" ] && [ "${st%%|*}" != "none" ]
}

acct_expiry() {  # $1=account name -> access seconds remaining, "none" or "dead"
  local st; st="$(cred_state "$ACCOUNTS/$1/credentials.json")"
  printf '%s' "${st%%|*}"
}

acct_refresh_expiry() {  # $1=account name -> refresh-token seconds, "none"/"dead"
  local st; st="$(cred_state "$ACCOUNTS/$1/credentials.json")"
  printf '%s' "${st##*|}"
}

fmt_left() {  # $1=seconds, "none" or "dead"
  local s="$1"
  if [ "$s" = "dead" ]; then printf 'BROKEN - re-login'; return; fi
  if [ "$s" = "none" ]; then printf 'unknown'; return; fi
  if [ "$s" -le 0 ]; then printf 'expired %dh ago' $(( -s / 3600 )); return; fi
  printf 'valid %dh %dm' $(( s / 3600 )) $(( (s % 3600) / 60 ))
}

fmt_days() {  # $1=seconds, "none" or "dead"
  local s="$1"
  case "$s" in dead) printf '-';; none) printf '?';; *) printf '%dd' $(( s / 86400 ));; esac
}

# --- state ------------------------------------------------------------------
active_name() { if [ -f "$ACTIVE_FILE" ]; then cat "$ACTIVE_FILE"; fi; }
acct_exists() { [ -d "$ACCOUNTS/$1" ]; }

validate_name() {
  case "$1" in
    ""|*[!a-zA-Z0-9._-]*) die "invalid account name '$1' (use letters, digits, . _ -)" ;;
  esac
}

# True only when an interactive Claude Code session is running. Several
# long-lived helpers share the same binary and process name - notably the
# Claude-in-Chrome native messaging host, which Chrome keeps alive for as long
# as the browser is open. Matching those would block every switch and login
# indefinitely, so candidates are filtered by their command line.
claude_session_pids() {
  local bin pids p cmd
  bin="$(command -v claude 2>/dev/null)" || return 0
  [ -n "$bin" ] || return 0
  pids="$( { pgrep -x claude; pgrep -f -- "$bin"; } 2>/dev/null | sort -un)"
  for p in $pids; do
    cmd="$(ps -o args= -p "$p" 2>/dev/null)" || continue
    [ -n "$cmd" ] || continue
    case "$cmd" in
      # Chrome's native messaging host, not a session
      *--chrome-native-host*) continue ;;
      # stdio MCP server, likewise long-lived and credential-free
      *" mcp serve"*|*" mcp start"*) continue ;;
      # ccswitch itself, or a shell whose command line merely mentions the path
      *ccswitch*) continue ;;
    esac
    printf '%s\n' "$p"
  done
}

claude_running() {
  [ -n "$(claude_session_pids)" ]
}

# Snapshot the live credential+identity into an account slot.
capture_into() {  # $1=account name
  local n="$1" d="$ACCOUNTS/$1"
  cred_exists || die "no live credential found - run 'claude' and /login first"

  local tmp; tmp="$(mktemp)"
  cred_read > "$tmp" 2>/dev/null || true
  [ -s "$tmp" ] || { rm -f "$tmp"; die "the live credential came back empty - refusing to store it as '$n'"; }

  # Claude Code blanks the tokens in place when the server rejects a refresh
  # with invalid_grant. Snapshotting that would destroy a good stored slot and
  # turn one re-login into a permanently broken account.
  local st; st="$(cred_state "$tmp")"
  if [ "${st%%|*}" = "dead" ]; then
    rm -f "$tmp"
    die "the live credential has been cleared (signed out) - refusing to overwrite '$n'.
       Sign in again, then run 'ccswitch save'."
  fi

  mkdir -p "$d"
  mv "$tmp" "$d/credentials.json"
  identity_extract "$CC_JSON" > "$d/identity.json"
  chmod 700 "$d"; chmod 600 "$d"/*.json
}

# Restore an account slot into the live location.
restore_from() {  # $1=account name
  local n="$1" d="$ACCOUNTS/$1"
  [ -f "$d/credentials.json" ] || die "account '$n' has no stored credential"
  cred_write "$d/credentials.json"
  [ -f "$d/identity.json" ] && identity_apply "$CC_JSON" "$d/identity.json"
  printf '%s\n' "$n" > "$ACTIVE_FILE"
}

# Save the live state back into whichever account is currently active, so a
# token refreshed during the session is not lost when we switch away.
save_active() {
  local cur; cur="$(active_name)"
  [ -n "$cur" ] || return 0
  cred_exists || return 0
  # A cleared credential is worth nothing, so there is nothing to save - but it
  # must not stop us leaving. Being signed out is exactly when switching away
  # matters most, and capture_into refuses a cleared credential by design.
  cred_live_ok || {
    warn "the live credential is signed out - leaving ${B}$cur${RST} as last saved"
    return 0
  }
  capture_into "$cur"
}

# True when the live .claude.json identity is the one stored for $1.
identity_matches() {  # $1=account name
  python3 - "$CC_JSON" "$ACCOUNTS/$1/identity.json" <<'PYEOF'
import json, os, sys
def ident(p):
    if not os.path.exists(p):
        return None
    try:
        d = json.load(open(p))
    except Exception:
        return None
    email = (d.get("oauthAccount") or {}).get("emailAddress")
    return (email or "").strip().lower() or None
# Match on the account's email alone. userID is not the account identifier: the
# same userID has been observed against two different accounts, and it changes
# across logins, so comparing it produced false mismatches - which silently
# disabled the sync that keeps the vault from holding a consumed token.
live, stored = ident(sys.argv[1]), ident(sys.argv[2])
# Unknown on either side is not a mismatch we can act on - stay conservative
# and only block when both are known and actually differ.
raise SystemExit(1 if (live and stored and live != stored) else 0)
PYEOF
}

# Refresh tokens rotate: each use consumes the old one. If the live credential
# has moved on and the vault still holds the superseded token, restoring that
# snapshot later gets invalid_grant and forces a browser re-login. Claude Code
# rotates during a session and on /login, neither of which goes through
# ccswitch - so sync opportunistically on every run rather than only on switch.
sync_active() {
  local cur; cur="$(active_name)"
  [ -n "$cur" ] || return 0
  acct_exists "$cur" || return 0
  cred_exists || return 0
  cred_live_ok || return 0

  # Only sync when the live identity really is the active account. A /login as
  # a different account leaves ccswitch's idea of "active" stale, and syncing
  # then would write the wrong credential into this slot.
  identity_matches "$cur" || return 0

  local stored="$ACCOUNTS/$cur/credentials.json"
  local tmp; tmp="$(mktemp)"
  cred_read > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
  if [ -s "$tmp" ] && ! cmp -s "$tmp" "$stored"; then
    mkdir -p "$ACCOUNTS/$cur"
    mv "$tmp" "$stored"
    chmod 600 "$stored"
    identity_extract "$CC_JSON" > "$ACCOUNTS/$cur/identity.json"
    chmod 600 "$ACCOUNTS/$cur/identity.json"
  else
    rm -f "$tmp"
  fi
}

# --- commands ---------------------------------------------------------------
cmd_add() {
  local n="${1:-}"; [ -n "$n" ] || die "usage: ccswitch add <name>"
  validate_name "$n"
  acct_exists "$n" && die "account '$n' already exists (use 'ccswitch rm $n' first)"
  capture_into "$n"
  printf '%s\n' "$n" > "$ACTIVE_FILE"
  info "${GRN}added${RST} $n  ($(acct_email "$n"))"
}

cmd_use() {
  local n="${1:-}" force="${2:-}"
  [ -n "$n" ] || die "usage: ccswitch use <name>"
  acct_exists "$n" || die "no such account '$n' (see: ccswitch list)"

  if [ "$n" = "$(active_name)" ]; then
    info "already on ${B}$n${RST}"
    return 0
  fi

  if [ "$force" != "--force" ] && claude_running; then
    die "a claude process is running - exit it first, or pass --force"
  fi

  save_active
  restore_from "$n"

  local left; left="$(acct_expiry "$n")"
  info "${GRN}switched to${RST} ${B}$n${RST}  ($(acct_email "$n"))  $(fmt_left "$left")"
  if [ "$left" != "none" ] && [ "$left" -le 0 ]; then
    warn "this token is expired - run 'ccswitch login $n' to refresh it"
  fi
}

cmd_list() {
  local cur; cur="$(active_name)"
  local found=0
  printf '%s  %-12s %-30s %-20s %-8s%s\n' "$B" "ACCOUNT" "EMAIL" "TOKEN" "RELOGIN" "$RST"
  for d in "$ACCOUNTS"/*/; do
    [ -d "$d" ] || continue
    found=1
    local n; n="$(basename "$d")"
    local mark="  "; [ "$n" = "$cur" ] && mark="${GRN}* ${RST}"
    local st; st="$(cred_state "$d/credentials.json")"
    printf '%s%-12s %-30s %-20s %-8s\n' "$mark" "$n" "$(acct_email "$n")" \
      "$(fmt_left "${st%%|*}")" "$(fmt_days "${st##*|}")"
  done
  [ "$found" = 1 ] || info "${DIM}no accounts yet - run: ccswitch login <name>${RST}"
  update_notice
}

cmd_current() {
  local cur; cur="$(active_name)"
  [ -n "$cur" ] || { info "none"; return 1; }
  printf '%s\n' "$cur"
}

cmd_login() {
  local n="${1:-}"; [ -n "$n" ] || die "usage: ccswitch login <name>"
  validate_name "$n"
  command -v claude >/dev/null 2>&1 || die "the 'claude' command was not found on PATH"

  claude_running && die "a claude process is running - exit it first"

  save_active

  # Clear the live credential so Claude Code prompts for a fresh sign-in.
  cred_clear
  local tmp_id; tmp_id="$(mktemp)"
  echo '{}' > "$tmp_id"
  identity_apply "$CC_JSON" "$tmp_id"
  rm -f "$tmp_id"

  info "Starting Claude Code. Run ${B}/login${RST} inside it, then exit with ${B}/exit${RST}."
  info ""
  claude || true
  info ""

  if ! cred_exists; then
    warn "no credential was written - sign-in did not complete. Nothing saved."
    local cur; cur="$(active_name)"
    [ -n "$cur" ] && acct_exists "$cur" && { restore_from "$cur"; info "restored previous account: $cur"; }
    return 1
  fi

  capture_into "$n"
  printf '%s\n' "$n" > "$ACTIVE_FILE"
  info "${GRN}saved${RST} $n  ($(acct_email "$n"))  $(fmt_left "$(acct_expiry "$n")")"
}

cmd_rm() {
  local n="${1:-}"; [ -n "$n" ] || die "usage: ccswitch rm <name>"
  acct_exists "$n" || die "no such account '$n'"
  rm -rf "${ACCOUNTS:?}/$n"
  [ "$n" = "$(active_name)" ] && rm -f "$ACTIVE_FILE"
  info "removed $n"
}

cmd_rename() {
  local o="${1:-}" n="${2:-}"
  if [ -z "$o" ] || [ -z "$n" ]; then die "usage: ccswitch rename <old> <new>"; fi
  validate_name "$n"
  acct_exists "$o" || die "no such account '$o'"
  acct_exists "$n" && die "account '$n' already exists"
  mv "$ACCOUNTS/$o" "$ACCOUNTS/$n"
  [ "$o" = "$(active_name)" ] && printf '%s\n' "$n" > "$ACTIVE_FILE"
  info "renamed $o -> $n"
}

# Which stored account, if any, the live identity belongs to.
account_for_live_identity() {
  local d n
  for d in "$ACCOUNTS"/*/; do
    [ -d "$d" ] || continue
    n="$(basename "$d")"
    if identity_matches "$n"; then printf '%s\n' "$n"; return 0; fi
  done
  return 1
}

cmd_save() {
  local n="${1:-}"
  if [ -n "$n" ]; then
    acct_exists "$n" || die "no such account '$n' (see: ccswitch list)"
  else
    n="$(active_name)"
    [ -n "$n" ] || die "no active account to save"
    # Signing in with /login inside Claude Code changes the live account
    # without telling ccswitch, leaving 'active' pointing elsewhere. Saving
    # blindly would write this credential over a different account's slot.
    if ! identity_matches "$n"; then
      local owner; owner="$(account_for_live_identity || true)"
      if [ -n "$owner" ]; then
        die "the live credential belongs to '$owner', not the active account '$n'.
       Run 'ccswitch save $owner' to store it there."
      fi
      die "the live credential does not match the active account '$n', and no
       stored account matches it. Run 'ccswitch add <name>' to store it as new,
       or 'ccswitch save $n' to write it into '$n' anyway."
    fi
  fi
  capture_into "$n"
  printf '%s\n' "$n" > "$ACTIVE_FILE"
  info "${GRN}saved${RST} live credential into $n"
}

# How close to the refresh token's expiry we start renewing it, in days.
REFRESH_WINDOW_DAYS="${CCSWITCH_REFRESH_WINDOW_DAYS:-7}"

cmd_refresh() {
  local target="${1:-}" force="${2:-}" n names
  names=()
  if [ -z "$target" ] || [ "$target" = "--all" ]; then
    for d in "$ACCOUNTS"/*/; do
      [ -d "$d" ] || continue
      names+=("$(basename "$d")")
    done
  else
    acct_exists "$target" || die "no such account '$target' (see: ccswitch list)"
    names=("$target")
  fi
  [ "${#names[@]}" -gt 0 ] || die "no stored accounts to refresh"

  # Every refresh ROTATES the refresh token: the old one is consumed and a new
  # one issued. A rotation we fail to capture leaves the vault holding a dead
  # token, so refreshing is not free - do it only as the refresh token nears
  # its expiry, not merely because the 8h access token lapsed.
  local todo=() window=$(( REFRESH_WINDOW_DAYS * 86400 ))
  for n in "${names[@]}"; do
    local st; st="$(cred_state "$ACCOUNTS/$n/credentials.json")"
    local racc="${st%%|*}" rref="${st##*|}"
    if [ "$racc" = "dead" ]; then
      warn "skip    $n  ($(acct_email "$n"))  signed out - run 'ccswitch login $n'"
    elif [ "$force" = "--force" ]; then
      todo+=("$n")
    elif [ "$rref" != "none" ] && [ "$rref" -gt "$window" ]; then
      info "${DIM}skip${RST}    $n  ($(acct_email "$n"))  re-login in $(fmt_days "$rref") - not due yet"
    elif [ "$rref" = "none" ] && [ "$racc" != "none" ] && [ "$racc" -gt 0 ]; then
      # Older credentials carry no refreshTokenExpiresAt. Fall back to the
      # access token: a valid one means the refresh token was exercised
      # recently, so rotating it again now would be risk without benefit.
      info "${DIM}skip${RST}    $n  ($(acct_email "$n"))  $(fmt_left "$racc") - not due yet"
    else
      todo+=("$n")
    fi
  done
  # The scheduled refresh is the natural place to do the network check, so
  # 'list' can show the notice without ever reaching out itself.
  update_check >/dev/null 2>&1 || true

  [ "${#todo[@]}" -gt 0 ] || return 0

  command -v claude >/dev/null 2>&1 || die "the 'claude' command was not found on PATH"
  claude_running && die "a claude process is running - exit it first"

  local started; started="$(active_name)"
  local stash; stash="$(mktemp -d)"
  # Preserve whatever is live now (tracked or not) so it can be put back
  # exactly as found, even if it's not one of the accounts being refreshed.
  cred_exists && cred_read > "$stash/credentials.json"
  identity_extract "$CC_JSON" > "$stash/identity.json"

  # Put the starting account back however we leave - including on Ctrl-C, which
  # would otherwise strand the user signed in as whichever account the loop held.
  # shellcheck disable=SC2317
  _refresh_restore() {
    if [ -n "$started" ] && acct_exists "$started"; then
      restore_from "$started"
    elif [ -f "$stash/credentials.json" ]; then
      cred_write "$stash/credentials.json"
      identity_apply "$CC_JSON" "$stash/identity.json"
      rm -f "$ACTIVE_FILE"
    else
      cred_clear
      rm -f "$ACTIVE_FILE"
    fi
    rm -rf "$stash"
  }
  trap '_refresh_restore; trap - INT TERM EXIT; exit 130' INT TERM
  trap '_refresh_restore' EXIT

  for n in "${todo[@]}"; do
    local before; before="$(acct_expiry "$n")"
    restore_from "$n"

    # A minimal non-interactive call makes Claude Code exercise the refresh
    # token. --allowedTools "" keeps it from touching anything; -p skips the
    # workspace trust dialog.
    local rc=0
    (cd "$HOME" && claude -p "ok" --model haiku --allowedTools "" >/dev/null 2>&1) || rc=$?

    # Capture regardless of exit status. Claude Code may have rotated the token
    # before failing for an unrelated reason, and the replacement exists only in
    # the live credential - losing it would strand the account for good.
    if cred_live_ok; then
      capture_into "$n" 2>/dev/null || warn "could not save the refreshed credential for $n"
      local after; after="$(acct_expiry "$n")"
      if [ "$after" != "none" ] && [ "$after" != "dead" ] &&
         { [ "$before" = "none" ] || [ "$before" = "dead" ] || [ "$after" -gt "$before" ]; }; then
        info "${GRN}refreshed${RST} $n  ($(acct_email "$n"))  $(fmt_left "$after")"
      else
        warn "$n ran but its expiry did not advance - token may not have been renewed"
      fi
    else
      warn "could not refresh $n (exit $rc) - the server rejected its refresh token.
       Run 'ccswitch login $n' to sign in again."
    fi
  done
}

cmd_backup() {
  local out="${1:-$HOME/ccswitch-backup-$(date +%F-%H%M).tar.gz}"
  tar czf "$out" -C "$(dirname "$VAULT")" "$(basename "$VAULT")"
  chmod 600 "$out"
  info "backed up -> $out"
  warn "this archive contains live session tokens - store it somewhere encrypted"
}

cmd_restore() {
  local f="${1:-}"; [ -n "$f" ] || die "usage: ccswitch restore <file.tar.gz>"
  [ -f "$f" ] || die "no such file: $f"
  tar xzf "$f" -C "$(dirname "$VAULT")"
  info "restored vault from $f"
  cmd_list
}

# --- self-update ------------------------------------------------------------
REPO_SLUG="${CCSWITCH_REPO:-2hmad/ccswitch}"
UPDATE_CACHE="$VAULT/.latest-version"

# The real path of this script, following the symlink a package manager leaves
# in its bin directory - npm's global bin is a symlink farm, so the link name
# alone says nothing about where the package actually lives.
self_path() {
  local self
  self="$(command -v ccswitch 2>/dev/null || printf '%s' "$0")"
  python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$self" 2>/dev/null ||
    printf '%s' "$self"
}

# Where this copy came from, so 'update' does not fight a package manager.
install_method() {
  local self; self="$(self_path)"
  case "$self" in
    *node_modules*)    printf 'npm' ;;
    *Cellar*|*linuxbrew*|*homebrew*) printf 'brew' ;;
    *)                 printf 'standalone' ;;
  esac
}

fetch_url() {  # $1=url -> body on stdout, non-zero on failure
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --max-time 10 "$1"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO- --timeout=10 "$1"
  else
    return 1
  fi
}

# Latest published release tag, without the leading v.
latest_version() {
  fetch_url "https://api.github.com/repos/$REPO_SLUG/releases/latest" 2>/dev/null |
    python3 -c 'import json,sys
try:
    print((json.load(sys.stdin).get("tag_name") or "").lstrip("v"))
except Exception:
    pass' 2>/dev/null
}

# Numeric compare: 0 when $1 is newer than $2.
version_gt() {
  [ "$1" != "$2" ] || return 1
  python3 - "$1" "$2" <<'PYEOF'
import sys
def parts(v):
    out = []
    for chunk in v.split("."):
        num = "".join(c for c in chunk if c.isdigit())
        out.append(int(num) if num else 0)
    return out
a, b = parts(sys.argv[1]), parts(sys.argv[2])
n = max(len(a), len(b))
a += [0] * (n - len(a)); b += [0] * (n - len(b))
raise SystemExit(0 if a > b else 1)
PYEOF
}

# Refresh the cached "latest version" note. Network, so only called from
# commands where a short pause is acceptable - never from 'use' or 'list'.
update_check() {
  local v; v="$(latest_version)"
  [ -n "$v" ] || return 1
  mkdir -p "$VAULT"
  printf '%s\n' "$v" > "$UPDATE_CACHE" 2>/dev/null || true
  printf '%s' "$v"
}

# Offline: print a one-line notice if the cache says a newer version exists.
update_notice() {
  [ -z "${CCSWITCH_NO_UPDATE_NOTICE:-}" ] || return 0
  [ -f "$UPDATE_CACHE" ] || return 0
  local v; v="$(cat "$UPDATE_CACHE" 2>/dev/null)"
  [ -n "$v" ] || return 0
  if version_gt "$v" "$VERSION"; then
    info "${DIM}ccswitch $v is available (you have $VERSION) - run: ccswitch update${RST}"
  fi
}

cmd_update() {
  local check_only="" method
  [ "${1:-}" != "--check" ] || check_only=1
  method="$(install_method)"

  info "current: ${B}$VERSION${RST}"
  local latest; latest="$(update_check)" ||
    die "could not reach GitHub to check for updates"
  info "latest:  ${B}$latest${RST}"

  if ! version_gt "$latest" "$VERSION"; then
    info "${GRN}already up to date${RST}"
    return 0
  fi
  [ -z "$check_only" ] || { info "run 'ccswitch update' to install it"; return 0; }

  case "$method" in
    npm)  die "this copy was installed with npm - update it with:
       npm update -g @2hmad/ccswitch" ;;
    brew) die "this copy was installed with Homebrew - update it with:
       brew upgrade ccswitch" ;;
  esac

  local self; self="$(self_path)"
  [ -w "$(dirname "$self")" ] ||
    die "$self is not writable - reinstall with your package manager, or:
       curl -fsSL https://raw.githubusercontent.com/$REPO_SLUG/main/install.sh | bash"

  local tmp; tmp="$(mktemp)"
  fetch_url "https://raw.githubusercontent.com/$REPO_SLUG/v$latest/bin/ccswitch" > "$tmp" ||
    { rm -f "$tmp"; die "download failed"; }

  # Refuse anything that is not plausibly the script - a captive-portal HTML
  # page or a truncated download must never land on top of a working install.
  if ! head -1 "$tmp" | grep -q '^#!.*bash' ||
     ! grep -q "^VERSION=\"$latest\"" "$tmp" ||
     [ "$(wc -c < "$tmp")" -lt 4096 ]; then
    rm -f "$tmp"
    die "downloaded file does not look like ccswitch $latest - refusing to install it"
  fi
  bash -n "$tmp" 2>/dev/null || { rm -f "$tmp"; die "downloaded file has a syntax error - refusing to install it"; }

  chmod 755 "$tmp"
  # Rename rather than overwrite: bash reads a script incrementally, so writing
  # into the running file's inode would corrupt this very process.
  mv "$tmp" "$self" || { rm -f "$tmp"; die "could not replace $self"; }
  info "${GRN}updated${RST} $VERSION -> $latest"
}

cmd_doctor() {
  local ok=0 _none=""
  [ -n "$(active_name)" ] || _none="none"
  printf '%sccswitch %s%s\n\n' "$B" "$VERSION" "$RST"
  printf '  claude on PATH   : %s\n' "$(command -v claude || echo "${RED}not found${RST}")"
  printf '  config dir       : %s\n' "$CC_DIR"
  printf '  config json      : %s%s\n' "$CC_JSON" "$([ -f "$CC_JSON" ] || echo "  ${YLW}(missing)${RST}")"
  printf '  credential store : %s\n' "$(if [ "$BACKEND" = keychain ]; then printf 'macOS keychain (service %s, account %s)' "$(kc_service)" "$(kc_account)"; else printf '%s' "$CRED"; fi)"
  printf '  live credential  : %s\n' "$(cred_exists && echo present || echo "${YLW}absent${RST}")"
  printf '  claude sessions  : %s\n' "$(claude_session_pids | tr '\n' ' ' | sed 's/ $//' || true)$(claude_running || echo none)"
  printf '  vault            : %s\n' "$VAULT"
  printf '  active account   : %s\n' "$(active_name)${_none}"
  printf '  accounts stored  : %s\n' "$(find "$ACCOUNTS" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)"
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    printf '\n  %sCLAUDE_CONFIG_DIR is set%s (%s)\n' "$YLW" "$RST" "$CLAUDE_CONFIG_DIR"
    printf '  ccswitch is operating on that directory rather than ~/.claude.\n'
    printf '  If you previously used per-account CLAUDE_CONFIG_DIR wrappers,\n'
    printf '  unset it so all accounts share one config.\n'
    ok=1
  fi
  return $ok
}

cmd_completion() {
  case "${1:-}" in
    bash) cat <<'EOF'
_ccswitch() {
  local cur prev accounts
  cur="${COMP_WORDS[COMP_CWORD]}"; prev="${COMP_WORDS[COMP_CWORD-1]}"
  accounts=$(ls -1 "${CCSWITCH_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/ccswitch}/accounts" 2>/dev/null)
  case "$prev" in
    use|rm|rename|login|refresh|save) COMPREPLY=($(compgen -W "$accounts" -- "$cur")); return;;
  esac
  COMPREPLY=($(compgen -W "use add login list current rm rename save refresh backup restore doctor update completion help version" -- "$cur"))
}
complete -F _ccswitch ccswitch
EOF
    ;;
    zsh) cat <<'EOF'
#compdef ccswitch
_ccswitch() {
  local -a accounts cmds
  accounts=(${(f)"$(ls -1 ${CCSWITCH_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/ccswitch}/accounts 2>/dev/null)"})
  cmds=(use add login list current rm rename save refresh backup restore doctor update completion help version)
  if (( CURRENT == 2 )); then
    _describe 'command' cmds
    _describe 'account' accounts
  elif [[ $words[2] == (use|rm|rename|login|refresh|save) ]]; then
    _describe 'account' accounts
  fi
}
_ccswitch "$@"
EOF
    ;;
    *) die "usage: ccswitch completion <bash|zsh>" ;;
  esac
}

usage() {
  cat <<EOF
${B}ccswitch${RST} $VERSION - switch between Claude Code accounts

  Everything stays shared - MCP servers, plugins, skills, agents, history,
  settings and CLAUDE.md. Only the signed-in account changes.

${B}USAGE${RST}
  ccswitch <name>                switch to an account (shorthand for 'use')
  ccswitch use <name> [--force]  switch to an account
  ccswitch login <name>          sign a new account in and store it
  ccswitch add <name>            store the currently signed-in account
  ccswitch list                  list accounts, emails and token status
  ccswitch current               print the active account name
  ccswitch save [name]           write the live token back to its account
  ccswitch refresh [name|--all] [--force]
                                  refresh a stored token before it goes stale
  ccswitch rm <name>             forget an account
  ccswitch rename <old> <new>    rename an account
  ccswitch backup [file]         archive the vault
  ccswitch restore <file>        restore a vault archive
  ccswitch doctor                diagnose the setup
  ccswitch update [--check]      update ccswitch itself to the latest release
  ccswitch completion <bash|zsh> print a shell completion script

${B}EXAMPLE${RST}
  ccswitch login work
  ccswitch login personal
  ccswitch work
  claude                         # runs as 'work'

${B}ENVIRONMENT${RST}
  CCSWITCH_HOME    vault location (default \$XDG_CONFIG_HOME/ccswitch)
  CCSWITCH_BACKEND credential store: 'file' or 'keychain' (default: keychain
                   on macOS when no credentials file exists, else file)
  CCSWITCH_REFRESH_WINDOW_DAYS
                   how close to the refresh token's expiry 'refresh' renews it
                   (default 7)
  CCSWITCH_NO_UPDATE_NOTICE
                   set to any value to silence the 'update available' line
  NO_COLOR         disable colour
EOF
}

# --- dispatch ---------------------------------------------------------------
cmd="${1:-}"; shift 2>/dev/null || true

# Keep the active slot in step with the live credential before doing anything
# that might read or replace it. Skipped for 'restore', which replaces the
# whole vault, and for 'help'/'version', which touch nothing.
case "$cmd" in
  restore|help|-h|--help|version|-V|--version|completion|update|upgrade) ;;
  *) sync_active ;;
esac
case "$cmd" in
  use)                cmd_use "${1:-}" "${2:-}" ;;
  add)                cmd_add "${1:-}" ;;
  login)              cmd_login "${1:-}" ;;
  list|ls)            cmd_list ;;
  current)            cmd_current ;;
  save)               cmd_save "${1:-}" ;;
  refresh)            cmd_refresh "${1:-}" "${2:-}" ;;
  rm|remove|delete)   cmd_rm "${1:-}" ;;
  rename|mv)          cmd_rename "${1:-}" "${2:-}" ;;
  backup)             cmd_backup "${1:-}" ;;
  restore)            cmd_restore "${1:-}" ;;
  doctor)             cmd_doctor ;;
  completion)         cmd_completion "${1:-}" ;;
  update|upgrade)     cmd_update "${1:-}" ;;
  version|-V|--version) info "ccswitch $VERSION" ;;
  help|-h|--help)     usage ;;
  "")                 cmd_list ;;
  -*)                 die "unknown option: $cmd" ;;
  *)                  cmd_use "$cmd" "${1:-}" ;;   # ccswitch <name>
esac
